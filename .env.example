# Xerox Shop Management System Environment Configuration

# Port (default 3000)
PORT=3000

# Node Environment
NODE_ENV=production

# -------------------------------------------------------------
# Multi-User Authentication PINs (Optional Overrides)
# Default PINs: User 1: 1111 | User 2: 2222 | User 3: 3333
# -------------------------------------------------------------
PIN_USER1=1111
PIN_USER2=2222
PIN_USER3=3333

# -------------------------------------------------------------
# Option A: Cloud Database for Vercel (Upstash Redis / Vercel KV)
# Zero native drivers, 100% free forever, multi-device cloud sync!
# Get free credentials at: https://upstash.com or Vercel Storage
# -------------------------------------------------------------
# KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-token

# -------------------------------------------------------------
# Option B: Custom Data Directory for VPS / Docker / Render
# Point this to a persistent mounted volume
# -------------------------------------------------------------
# DATA_DIR=/var/data/xerox-shop
