# Xerox Shop Management System Environment Configuration

# Port (default 3000)
PORT=3000

# Custom Data Directory (Optional - default is ./.data)
# In Docker or VPS, point this to a persistent mounted volume
# DATA_DIR=/var/data/xerox-shop

# Custom Database File Path (Optional)
# DATABASE_FILE=./.data/shop-db.json

# Node Environment
NODE_ENV=production
